# Binance Spot Testnet — keys ONLY here on the server, never in Flutter.
# Copy to `.env` and replace placeholders. Never commit `.env`.

APP_NAME=Trading Bot API
ENVIRONMENT=production
DEBUG=false

# Cloud startup. Many hosts inject PORT automatically.
HOST=0.0.0.0
PORT=8001

# Startup execution mode: PAPER_DEMO, BINANCE_TESTNET, or ALPACA_PAPER.
EXECUTION_MODE=BINANCE_TESTNET

# CORS for Flutter/web clients.
# Use exact HTTPS origins in production, comma-separated:
# CORS_ORIGINS=https://your-flutter-app.example.com,https://your-admin.example.com
# Use * only for early demo testing when no cookies/credentials are required.
CORS_ORIGINS=*
CORS_ORIGIN_REGEX=

USE_BINANCE_TESTNET=false

BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision/api
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Alpaca Paper Trading - paper endpoint only, never live trading.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Public read-only spot (mainnet) used for GET /market/prices — no key.
BINANCE_PUBLIC_BASE_URL=https://api.binance.com

# AI advisor — recommendations only. The execution gate still controls trades.
# Choose one: MOCK, OPENAI, GEMINI
AI_ADVISOR_PROVIDER=MOCK

# ChatGPT / OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Increase if the provider is slow from your network.
AI_ADVISOR_TIMEOUT_SECONDS=60

# News Agent sources — choose one: MOCK, CRYPTOPANIC, FINNHUB, NEWSAPI, RSS
NEWS_PROVIDER=MOCK
NEWS_LOOKBACK_HOURS=12
NEWS_MAX_ITEMS=12

# Crypto news API
CRYPTOPANIC_API_KEY=

# Stocks + crypto news API
FINNHUB_API_KEY=

# General news API
NEWSAPI_API_KEY=

# Comma-separated RSS feeds, used only when NEWS_PROVIDER=RSS
# Example: https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss
NEWS_RSS_URLS=

# Safety: when true, new opens are blocked. Keep false only for supervised demo/testnet use.
BOT_KILL_SWITCH=false
